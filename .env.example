# Copie para .env.local (desenvolvimento) e preencha.

# URL do App da Web do Apps Script (termina em /exec).
# Vai para a Vercel em Settings → Environment Variables.
SHEETS_WEBHOOK_URL=

# Uma senha longa qualquer. A MESMA vai nas Propriedades do script do Apps Script.
# Vai para a Vercel em Settings → Environment Variables.
SHEETS_SECRET=

# Só para gerar os áudios no seu computador (node scripts/gerar-audios.mjs).
# NÃO coloque na Vercel.
ELEVENLABS_API_KEY=
